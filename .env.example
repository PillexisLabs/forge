# ─────────────────────────────────────────────────────────────
# Pillexis Marketing Analytics — copy to .env and fill in.
# See README.md for step-by-step instructions on each credential.
# ─────────────────────────────────────────────────────────────

# ── Database (any Postgres: Supabase, Neon, Vercel Postgres, local) ──
# Supabase: Project Settings → Database → Connection string (URI), use the
# "Transaction" pooler URL (port 6543) and keep ?sslmode=require.
DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=require
# Set to "disable" only for a local Postgres without TLS.
DATABASE_SSL=require

# ── Dashboard auth (single user) ──
DASHBOARD_PASSWORD=change-this-to-something-strong
# Used to sign the login cookie. Generate: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# ── Sync endpoint protection (for cron + the GitHub Action) ──
# Generate: openssl rand -hex 32
SYNC_SECRET=replace-with-another-long-random-string

# Scoped machine clients for /api/v1. Keep each secret unique so access can be
# audited and revoked independently. The browser dashboard does not use these.
API_CLIENTS_JSON='[{"id":"codex","secret":"replace-with-at-least-32-random-characters","scopes":["analytics:read"],"description":"Codex analytics reader"}]'

# ── Google Analytics 4 (Analytics Data API) ──
# NUMERIC property ID from GA Admin → Property Settings (NOT the G-VJFFZCJNEC measurement ID).
GA4_PROPERTY_ID=543367139
GA4_HOSTNAME=pillexislabs.com
# Paste the full service-account JSON on ONE line (or set GOOGLE_APPLICATION_CREDENTIALS
# to a file path instead and leave this blank).
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── Meta Marketing API ──
# Long-lived System User token (Business Settings → System Users → Generate token,
# scopes: ads_read). Defaults below are Pillexis's live account.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1705074640527431
META_GRAPH_VERSION=v23.0
