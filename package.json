{
  "name": "marketing-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Pillexis Labs marketing analytics dashboard — daily GA4 + Meta Ads sync with a cost-per-booking funnel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "next lint",
    "sync": "node --import ./scripts/load-env-if-present.mjs --import tsx scripts/sync-cli.ts",
    "crm:import": "node --import ./scripts/load-env-if-present.mjs --import tsx scripts/import-crm.ts",
    "crm:sync-fireflies": "node --import ./scripts/load-env-if-present.mjs --import tsx scripts/sync-crm-fireflies.ts",
    "db:migrate": "node --import ./scripts/load-env-if-present.mjs --import tsx scripts/migrate.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google-analytics/data": "^4.7.0",
    "@tremor/react": "^3.18.7",
    "date-fns": "^3.6.0",
    "eslint-config-next": "^14.2.35",
    "next": "^14.2.35",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
